# ---------------------------------------------------------------------------
# Este repositorio es PUBLICO y maneja un token que escribe en el backend.
# Regla: lo que huela a secreto, a respaldo o a estado local, no se versiona.
# ---------------------------------------------------------------------------

# Build y tipos generados
dist/
.astro/
*.tsbuildinfo

# Dependencias
node_modules/
.pnpm-store/

# Variables de entorno y secretos (solo se versiona .env.example)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
id_rsa*
id_ed25519*
*.token
secrets/
credentials*.json
service-account*.json

# Cloudflare / Wrangler: estado local, tokens y cache
.wrangler/
.cloudflared/
cloudflared*.json

# Respaldos y volcados de datos (el CMS toca datos reales: nunca al repo)
backups/
dumps/
*.sql
*.sqlite
*.sqlite3
*.db
*.bak
*.dump
*.csv

# Registros
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.pnpm-debug.log*

# Pruebas: reportes y artefactos
/coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.vitest-cache/

# Caches de herramientas
.cache/
.eslintcache
.biome-cache/

# Editores: solo se comparten las recomendaciones y el lanzador de depuracion
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Archivos comprimidos y de volcado de memoria
*.zip
*.tar
*.tgz
*.gz
*.rar
*.7z
*.hprof
*.heapsnapshot

# Claude Code: configuracion y estado solo locales
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# Heredado de Vercel (el sitio ya no se despliega ahi)
.vercel/

# El curriculum se sube desde el admin (R2); nunca se versiona en este repo publico.
/CV*.pdf
/CV*.docx
/cv*.pdf
/cv*.docx
