{
	// Cloudflare Workers config for the Astro SSR site (adapter @astrojs/cloudflare).
	// Build: `npx astro build`   Deploy: `npx wrangler deploy`
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portafolio",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": { "enabled": true },

	// Limite de peticiones por visitante en los POST publicos (comentarios y contacto).
	// Cada isolate tiene su propia memoria, asi que un contador en codigo no sirve:
	// este binding lo comparte Cloudflare. La clave es `<ruta>:<IP del visitante>`.
	"ratelimits": [
		{
			"name": "RL_PUBLIC_WRITE",
			"namespace_id": "1002",
			"simple": { "limit": 5, "period": 60 }
		}
	]
}
