---
import { ProjectsCatalog } from "@/features/projects/ProjectsCatalog";
import { getI18N } from "@/i18n";
import { DEFAULT_LOCALE } from "@/i18n/locales";

const currentLocale = Astro.currentLocale ?? DEFAULT_LOCALE;
const i18n = getI18N({ currentLocale });
---

<div class="mx-auto w-full max-w-[1240px] px-6 py-24 md:py-32">
	<h2 class="font-serif-display text-title" data-split>
		{i18n.PROJECTS.PROJECTS_TITLE}
	</h2>

	<!--
		One island, one request: the catalog asks for the projects from the browser
		once it is close to the viewport, so the first render (the hero) costs the
		backend nothing. It always renders a skeleton on the server (an empty island
		is never hydrated by client:visible, which observes the island's children).
	-->
	<div class="mt-16">
		<ProjectsCatalog
			client:visible={{ rootMargin: "500px" }}
			currentLocale={currentLocale}
		/>
	</div>
</div>
