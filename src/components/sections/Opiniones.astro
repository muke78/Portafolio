---
import { Opinions } from "@/features/opinions/Opinions";
import { API_SECRET_TOKEN } from "astro:env/server";
import { api } from "@/lib/api";
import type { Testimonial } from "@/types/currentLang.interface";

const { currentLocale } = Astro;

let initialData: Testimonial[] = [];
try {
	const { data } = await api.get("/comments", {
		headers: { Authorization: `Bearer ${API_SECRET_TOKEN}` },
	});
	initialData = (data?.data ?? []) as Testimonial[];
} catch (err) {
	console.error("SSR opiniones fetch failed", err);
}
---

<div class="isolate flex w-7xl items-start justify-start gap-4 lg:p-9 md:p-8 sm:p-4 p-4 mt-16">
    <Opinions client:visible currentLocale={currentLocale} initialData={initialData}/>
</div>
