---
import { dataListNavbarEN } from "@/data/locales/en/dataNavbarEN";
import { dataListNavbar } from "@/data/locales/es/dataNavbar";
import { dataListNavbarFR } from "@/data/locales/fr/dataNavbarFR";
import { ReplayPrompt } from "@/features/intro/ReplayPrompt";
import { getI18N } from "@/i18n";
import { DEFAULT_LOCALE } from "@/i18n/locales";
import { mailtoUrl } from "@/lib/contactLinks";
import { getContact } from "@/lib/siteContact";

const currentLocale = Astro.currentLocale ?? DEFAULT_LOCALE;
const i18n = getI18N({ currentLocale });
const contact = await getContact();

const navByLocale = {
	es: dataListNavbar,
	en: dataListNavbarEN,
	fr: dataListNavbarFR,
} as const;
const navItems =
	navByLocale[currentLocale as keyof typeof navByLocale] ?? dataListNavbar;

const year = new Date().getFullYear();
---

<section class="wordmark-reveal h-[60vh] min-h-[360px] flex items-center justify-center">
	<div class="wordmark-galaxy hidden md:block">
		<svg width="520" height="520" viewBox="0 0 200 200" class="galaxy-svg" role="presentation">
			<defs>
				<radialGradient id="footer-halo" cx="50%" cy="50%" r="50%">
					<stop offset="0%" stop-color="currentColor" stop-opacity="0.32"></stop>
					<stop offset="60%" stop-color="currentColor" stop-opacity="0.08"></stop>
					<stop offset="100%" stop-color="currentColor" stop-opacity="0"></stop>
				</radialGradient>
			</defs>
			<circle cx="100" cy="100" r="98" fill="url(#footer-halo)"></circle>
		</svg>
	</div>
	<div class="relative z-[1] flex items-baseline">
		<span class="wordmark">Khelde<span class="dot">.</span></span>
	</div>
</section>

<footer class="border-t border-border py-14 bg-background">
	<div class="mx-auto max-w-[1240px] px-6">
		<div class="grid grid-cols-1 md:grid-cols-[1.4fr_1fr_1fr] gap-10 mb-14">
			<p class="font-serif-display text-heading max-w-[32ch]">
				«{i18n.OPINIONS.OPINIONS_SUBTITLE}»
			</p>
			<div>
				<h2 class="eyebrow mb-4">{i18n.FOOTER.SITE}</h2>
				<ul class="flex flex-col gap-2">
					{navItems.map((item) => (
						<li>
							<a href={item.to} class="text-sm text-muted-foreground transition-colors hover:text-primary">
								{item.label}
							</a>
						</li>
					))}
				</ul>
			</div>
			<div>
				<h2 class="eyebrow mb-4">{i18n.FOOTER.ELSEWHERE}</h2>
				<ul class="flex flex-col gap-2">
					<li><a href={contact.github_url} target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground transition-colors hover:text-primary">GitHub</a></li>
					<li><a href={contact.linkedin_url} target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground transition-colors hover:text-primary">LinkedIn</a></li>
					<li><a href={mailtoUrl(contact.email)} class="text-sm text-muted-foreground transition-colors hover:text-primary">Email</a></li>
				</ul>
			</div>
		</div>
		<div class="flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-border font-mono text-xs text-muted-foreground">
			<span>© {year} Erick González · Khelde</span>
			<ReplayPrompt client:visible currentLocale={currentLocale} />
		</div>
	</div>
</footer>

<script>
	const el = document.querySelector<HTMLElement>(".wordmark-reveal");
	const word = el?.querySelector<HTMLElement>(".wordmark");
	if (el && word && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const onScroll = () => {
			const rect = el.getBoundingClientRect();
			const vh = window.innerHeight;
			const center = rect.top + rect.height / 2;
			const progress = (vh / 2 - center) / (vh / 2 + rect.height / 2);
			const shift = progress * 80;
			const scale = 1 + Math.abs(progress) * 0.04;
			word.style.transform = `translate3d(${-shift}px, 0, 0) scale(${scale})`;
		};
		window.addEventListener("scroll", onScroll, { passive: true });
		onScroll();
	}
</script>
