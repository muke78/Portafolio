---
import { Image } from "astro:assets";
import {
	ArrowDown,
	Mail,
	MessageCircle,
	MoveRight,
	SquareArrowOutUpRight,
} from "lucide-react";
import heroPortrait from "@/assets/img/hero-portrait.webp";
import { GithubIcon, LinkedinIcon } from "@/components/icons/BrandIcons";
import { buttonVariants } from "@/components/ui/button";
import { getI18N } from "@/i18n";
import { DEFAULT_LOCALE } from "@/i18n/locales";
import { mailtoUrl, whatsappUrl } from "@/lib/contactLinks";
import { mediaUrl } from "@/lib/media";
import { getContact } from "@/lib/siteContact";
import { getSiteCopy } from "@/lib/siteCopy";
import { cn } from "@/lib/utils";

const currentLocale = Astro.currentLocale ?? DEFAULT_LOCALE;
const i18n = getI18N({ currentLocale });
const contact = await getContact();
// Foto y textos del hero vienen del CMS; si el backend no responde, los archivos de
// idioma y la foto estatica del repo (`hero-portrait.webp`) hacen de respaldo.
const copy = await getSiteCopy(currentLocale);
const heroLabel = copy?.hero_label ?? i18n.HEADER.HEADER_SUBTITLE;
const heroLead = copy?.hero_lead ?? i18n.HEADER.HEADER_ABOUT;
const heroAlt = copy?.hero_image_alt ?? "muke78";
const heroSrc = copy ? mediaUrl(copy.hero_image) : null;
// El PDF del curriculum se sube desde el admin; sin PDF cargado no hay boton.
const cvHref = copy?.cv_pdf ? mediaUrl(copy.cv_pdf) : null;

// Hero CTAs reuse the shadcn Button styles (buttonVariants) on a real <a>:
// .astro files can't pass the JSX element Base UI's `render` prop needs.
// Pill radius is the hero's design; min-h-11 = 44px touch target (WCAG 2.5.5).
const heroCta = "h-auto min-h-11 gap-2 rounded-full px-5 py-3";

// "Erick González" -> two stacked lines; the surname is set in italic
// violet and shifted right so the name reads as one staggered block.
const nameParts = i18n.HEADER.HEADER_NAME.split(" ");
const firstName = nameParts.slice(0, -1).join(" ") || nameParts[0];
const lastName = nameParts.length > 1 ? nameParts.at(-1) : "";

const social =
	"inline-flex size-11 items-center justify-center rounded-full text-muted-foreground transition-colors hover-press hover:bg-primary/10 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
---

<!--
	HERO. One focal point: the name, set at poster scale. The portrait sits in
	an arch inside two quiet orbit rings (a nod to the galaxy behind it), and
	the galaxy canvas is a background layer pushed to the right/below it, so
	nothing competes with the headline.

	Motion contract (src/lib/motion.ts -> playHero): [data-hero] is the root;
	the data-hero-* parts below are animated in one sequence. CSS only hides
	them while <html> has .motion-ok (JS running AND motion allowed).
-->
<div
	class="flex min-h-[calc(100svh-72px)] flex-col justify-between overflow-x-clip pb-8 pt-8 md:pt-10"
	data-hero
>
	<div class="grid flex-1 grid-cols-1 items-center gap-14 lg:grid-cols-12 lg:gap-8">
		<div class="relative lg:col-span-7">
			<p class="eyebrow mb-6" data-hero-label>{heroLabel}</p>

			<h1 class="font-serif-display text-hero">
				<!--
					Each line sits in a mask; GSAP lifts the inner span out of it. The
					padding and negative margin leave room for accents and ascenders
					without moving the layout.
				-->
				<span class="block -mt-[0.16em] overflow-hidden pt-[0.16em] pb-[0.04em]">
					<span class="block" data-hero-line>{firstName}</span>
				</span>
				{
					lastName && (
						<span class="block overflow-hidden pb-[0.06em]">
							<span class="block italic text-primary lg:pl-[0.4em]" data-hero-line>
								{lastName}
							</span>
						</span>
					)
				}
			</h1>

			<p
				class="khelde-lead mt-8 max-w-[46ch] text-muted-foreground"
				data-hero-lead
			>
				{heroLead}
			</p>

			<div class="mt-8 flex flex-wrap items-center gap-3" data-hero-cta>
				<a
					href={`/${currentLocale}/home#projects`}
					class={cn(buttonVariants({ variant: "default" }), heroCta)}
				>
					{i18n.HEADER.HEADER_BUTTON}
					<MoveRight
						size={16}
						className="transition-transform duration-300 motion-safe:group-hover/button:translate-x-1"
					/>
				</a>
				<a
					href={`/${currentLocale}/home#contact`}
					class={cn(buttonVariants({ variant: "outline" }), heroCta)}
				>
					{i18n.HEADER.HEADER_TALK}
				</a>
				{
					cvHref && (
						<a
							href={cvHref}
							target="_blank"
							rel="noopener noreferrer"
							class={cn(buttonVariants({ variant: "ghost" }), heroCta)}
							aria-label={i18n.HEADER.HEADER_CV_ARIA_LABEL}
						>
							{i18n.ABOUTME.ABOUT_DOWNLOAD_CV}
							<SquareArrowOutUpRight size={15} />
						</a>
					)
				}
			</div>
		</div>

		<div class="relative lg:col-span-5">
			<div
				class="relative mx-auto w-full max-w-[320px] sm:max-w-[360px] lg:ml-auto lg:mr-0 lg:max-w-[400px]"
			>
				<!--
					Orbit rings: decorative, quiet, tied to the galaxy behind. The
					wrapper carries the (very subtle) scroll parallax; the svg carries
					the entrance (the solid ring is drawn on, pathLength=1).
				-->
				<div
					aria-hidden="true"
					class="pointer-events-none absolute inset-0 -z-10"
					data-parallax="6"
				>
					<svg
						viewBox="0 0 400 400"
						fill="none"
						class="absolute left-1/2 top-1/2 h-[118%] w-[118%] -translate-x-1/2 -translate-y-1/2 text-primary/40 lg:h-[138%] lg:w-[138%]"
						data-hero-rings
					>
						<ellipse
							cx="200"
							cy="200"
							rx="190"
							ry="150"
							stroke="currentColor"
							stroke-width="1"
							transform="rotate(-18 200 200)"
							pathLength="1"
							data-hero-ring-solid></ellipse>
						<ellipse
							cx="200"
							cy="200"
							rx="150"
							ry="112"
							stroke="currentColor"
							stroke-width="1"
							stroke-dasharray="2 7"
							transform="rotate(-18 200 200)"
							data-hero-ring-accent></ellipse>
						<circle cx="381" cy="141" r="5" class="fill-primary" data-hero-ring-accent
						></circle>
					</svg>
				</div>

				<div
					class="relative aspect-[3/4] overflow-hidden rounded-t-[999px] rounded-b-3xl border border-border bg-muted shadow-[var(--glow)]"
					data-hero-portrait
				>
					{
						heroSrc ? (
							<>
								{/* LCP: se pide desde el primer byte del HTML, no al llegar al <img>. */}
								<link rel="preload" as="image" href={heroSrc} fetchpriority="high" />
								<img
									src={heroSrc}
									alt={heroAlt}
									draggable="false"
									loading="eager"
									fetchpriority="high"
									decoding="async"
									class="h-full w-full object-cover"
								/>
							</>
						) : (
							<Image
								src={heroPortrait}
								alt={heroAlt}
								draggable="false"
								loading="eager"
								fetchpriority="high"
								widths={[360, 540, 672]}
								sizes="(min-width: 1024px) 400px, 72vw"
								class="h-full w-full object-cover"
							/>
						)
					}
					<!-- LCP: the photo is painted from the first frame; while .motion-ok this
					     cover hides it and the hero sequence wipes the cover away. Clipping
					     the photo itself kept it out of the LCP until the JS engine ran. -->
					<div data-hero-cover aria-hidden="true" class="absolute inset-0 hidden bg-background"></div>
				</div>
			</div>
		</div>
	</div>

	<div
		class="mt-10 flex items-center justify-between gap-6 border-t border-border pt-5"
		data-hero-bar
	>
		<div class="flex items-center gap-1">
			<a
				href={contact.github_url}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={i18n.HEADER.HEADER_GITHUB_ARIA_LABEL}
				class={social}
			>
				<GithubIcon size={22} aria-hidden="true" />
			</a>
			<a
				href={contact.linkedin_url}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={i18n.HEADER.HEADER_LINKEDIN_ARIA_LABEL}
				class={social}
			>
				<LinkedinIcon size={22} aria-hidden="true" />
			</a>
			<a
				href={whatsappUrl(contact.phone)}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={i18n.HEADER.HEADER_WHATSAPP_ARIA_LABEL}
				class={social}
			>
				<MessageCircle size={22} />
			</a>
			<a
				href={mailtoUrl(contact.email)}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={i18n.HEADER.HEADER_EMAIL_ARIA_LABEL}
				class={social}
			>
				<Mail size={22} />
			</a>
		</div>

		<a
			href="#what"
			class="group/scroll hidden min-h-11 items-center gap-3 rounded-full px-2 text-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:inline-flex"
		>
			{i18n.HEADER.HEADER_SCROLL}
			<span aria-hidden="true" class="relative block h-10 w-px overflow-hidden bg-border">
				<span class="absolute inset-x-0 top-0 h-4 bg-primary motion-safe:animate-[scroll-cue_2.2s_ease-in-out_infinite]"></span>
			</span>
			<ArrowDown size={16} aria-hidden="true" />
		</a>
	</div>
</div>
