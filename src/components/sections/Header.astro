---
import {
	Github,
	Linkedin,
	Mail,
	MessageCircle,
	MoveRight,
	SquareArrowOutUpRight,
} from "lucide-react";
import { getI18N } from "@/i18n";
import { Image } from "astro:assets";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

// "Erick González" -> italicize the last word (matches the source
// design's name treatment) without hardcoding the split for every
// locale — the name itself doesn't translate.
const nameParts = i18n.HEADER.HEADER_NAME.split(" ");
const firstName = nameParts.slice(0, -1).join(" ") || nameParts[0];
const lastName = nameParts.length > 1 ? nameParts.at(-1) : "";
---

<div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_320px] gap-10 lg:gap-12 items-start pt-8 pb-14">
	<div>
		<div class="flex flex-wrap items-center gap-5 mb-6">
			<span class="eyebrow">— {i18n.HEADER.HEADER_SUBTITLE}</span>
		</div>

		<h1 class="font-serif-display text-[clamp(56px,8.4vw,120px)] anim-fade-in">
			{firstName}
			{lastName && <><br /><span class="italic text-primary">{lastName}</span></>}
		</h1>

		<p class="khelde-lead mt-6 text-muted-foreground">
			{i18n.HEADER.HEADER_ABOUT}
		</p>

		<div class="flex flex-wrap items-center gap-3 mt-8">
			<a
				href={`/${currentLocale}/home#projects`}
				class="inline-flex items-center gap-2 rounded-full bg-primary text-primary-foreground px-5 py-3 text-sm font-medium transition-opacity hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
			>
				{i18n.HEADER.HEADER_BUTTON}
				<MoveRight size={16} />
			</a>
			<a
				href={`/${currentLocale}/home#contact`}
				class="inline-flex items-center gap-2 rounded-full border border-border px-5 py-3 text-sm font-medium text-foreground transition-colors hover:border-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
			>
				{i18n.HEADER.HEADER_TALK}
			</a>
			<a
				href="https://q8mthsih9ooiwevt.public.blob.vercel-storage.com/CV_Erick_Miguel_Gonzalez_Rivera.pdf"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 rounded-full border border-border px-5 py-3 text-sm font-medium text-foreground transition-colors hover:border-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
				aria-label="Ver cv para saber mas acerca de mi"
			>
				{i18n.ABOUTME.ABOUT_DOWNLOAD_CV}
				<SquareArrowOutUpRight size={15} />
			</a>
		</div>

		<div class="flex items-center gap-5 mt-9">
			<a
				href="https://github.com/muke78"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Saber mas acerca de mis repositorios y lo que he hecho"
				class="text-muted-foreground transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded-full"
			>
				<Github size={22} />
			</a>
			<a
				href="https://www.linkedin.com/in/erick-miguel-gonz%C3%A1lez-rivera-96265b248/"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Saber mas acerca de experiencia"
				class="text-muted-foreground transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded-full"
			>
				<Linkedin size={22} />
			</a>
			<a
				href="https://wa.me/+525511909105"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Número de teléfono"
				class="text-muted-foreground transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded-full"
			>
				<MessageCircle size={22} />
			</a>
			<a
				href="mailto:erickm.gonzalez.rivera@gmail.com"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Correo electrónico"
				class="text-muted-foreground transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded-full"
			>
				<Mail size={22} />
			</a>
		</div>
	</div>

	<div class="relative mx-auto w-full max-w-[320px] lg:max-w-none anim-zoom-in">
		<div class="aspect-[4/5] overflow-hidden rounded-sm border border-border bg-muted">
			<Image
				src="/e9721e9d-cfa4-47ce-9f2c-40ec23335d62.webp"
				width={640}
				height={800}
				alt="muke78"
				draggable="false"
				class="h-full w-full object-cover"
			/>
		</div>
	</div>
</div>
