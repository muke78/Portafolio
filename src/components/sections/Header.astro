---
import { Image } from "astro:assets";
import {
	Mail,
	MessageCircle,
	MoveRight,
	SquareArrowOutUpRight,
} from "lucide-react";
import heroPortrait from "@/assets/img/hero-portrait.webp";
import { GithubIcon, LinkedinIcon } from "@/components/icons/BrandIcons";
import { buttonVariants } from "@/components/ui/button";
import { getI18N } from "@/i18n";
import { cn } from "@/lib/utils";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

// "Erick González" -> italicize the last word (matches the source
// design's name treatment) without hardcoding the split for every
// locale — the name itself doesn't translate.
// Hero CTAs reuse the shadcn Button styles (buttonVariants) on a real <a>:
// .astro files can't pass the JSX element Base UI's `render` prop needs.
// Pill radius is the hero's design; min-h-11 = 44px touch target (WCAG 2.5.5).
const heroCta = "h-auto min-h-11 gap-2 rounded-full px-5 py-3";

const nameParts = i18n.HEADER.HEADER_NAME.split(" ");
const firstName = nameParts.slice(0, -1).join(" ") || nameParts[0];
const lastName = nameParts.length > 1 ? nameParts.at(-1) : "";
---

<div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_320px] gap-10 lg:gap-12 items-start pt-8 pb-14">
	<div class="relative">
		<!--
			Text-protection scrim: the galaxy/cosmos canvas sits fixed behind
			the whole page, and its bright core can drift under this column.
			This gradient (opaque background color fading to transparent)
			guarantees the headline/description stay readable no matter where
			the animation currently is, without hiding the visual outright.
		-->
		<div
			aria-hidden="true"
			class="pointer-events-none absolute -inset-x-16 -inset-y-20 -z-10 bg-[radial-gradient(ellipse_70%_65%_at_30%_50%,color-mix(in_oklch,var(--background),transparent_8%)_30%,color-mix(in_oklch,var(--background),transparent_55%)_58%,transparent_80%)]"
		></div>
		<div class="flex flex-wrap items-center gap-5 mb-6">
			<span class="eyebrow">— {i18n.HEADER.HEADER_SUBTITLE}</span>
		</div>

		<h1 class="font-serif-display text-display anim-fade-in">
			{firstName}
			{lastName && <><br /><span class="italic text-primary">{lastName}</span></>}
		</h1>

		<p class="khelde-lead mt-6 text-muted-foreground">
			{i18n.HEADER.HEADER_ABOUT}
		</p>

		<div class="flex flex-wrap items-center gap-3 mt-8">
			<a
				href={`/${currentLocale}/home#projects`}
				class={cn(buttonVariants({ variant: "default" }), heroCta)}
			>
				{i18n.HEADER.HEADER_BUTTON}
				<MoveRight size={16} />
			</a>
			<a
				href={`/${currentLocale}/home#contact`}
				class={cn(buttonVariants({ variant: "outline" }), heroCta)}
			>
				{i18n.HEADER.HEADER_TALK}
			</a>
			<a
				href="https://q8mthsih9ooiwevt.public.blob.vercel-storage.com/CV_Erick_Miguel_Gonzalez_Rivera.pdf"
				target="_blank"
				rel="noopener noreferrer"
				class={cn(buttonVariants({ variant: "outline" }), heroCta)}
				aria-label={i18n.HEADER.HEADER_CV_ARIA_LABEL}
			>
				{i18n.ABOUTME.ABOUT_DOWNLOAD_CV}
				<SquareArrowOutUpRight size={15} />
			</a>
		</div>

		<div class="flex items-center gap-5 mt-9">
			<a
				href="https://github.com/muke78"
				target="_blank"
				rel="noopener noreferrer"
				aria-label={i18n.HEADER.HEADER_GITHUB_ARIA_LABEL}
				class="text-muted-foreground transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded-full"
			>
				<GithubIcon size={22} aria-hidden="true" />
			</a>
			<a
				href="https://www.linkedin.com/in/erick-miguel-gonz%C3%A1lez-rivera-96265b248/"
				target="_blank"
				rel="noopener noreferrer"
				aria-label={i18n.HEADER.HEADER_LINKEDIN_ARIA_LABEL}
				class="text-muted-foreground transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded-full"
			>
				<LinkedinIcon size={22} aria-hidden="true" />
			</a>
			<a
				href="https://wa.me/+525511909105"
				target="_blank"
				rel="noopener noreferrer"
				aria-label={i18n.HEADER.HEADER_WHATSAPP_ARIA_LABEL}
				class="text-muted-foreground transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded-full"
			>
				<MessageCircle size={22} />
			</a>
			<a
				href="mailto:erickm.gonzalez.rivera@gmail.com"
				target="_blank"
				rel="noopener noreferrer"
				aria-label={i18n.HEADER.HEADER_EMAIL_ARIA_LABEL}
				class="text-muted-foreground transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded-full"
			>
				<Mail size={22} />
			</a>
		</div>
	</div>

	<div class="relative mx-auto w-full max-w-[320px] lg:max-w-none anim-zoom-in">
		<div class="aspect-[4/5] overflow-hidden rounded-sm border border-border bg-muted">
			<Image
				src={heroPortrait}
				alt="muke78"
				draggable="false"
				class="h-full w-full object-cover"
			/>
		</div>
	</div>
</div>
