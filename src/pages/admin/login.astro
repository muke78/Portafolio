---
import AdminLayoutBare from "@/layouts/AdminLoginLayout.astro";
---

<AdminLayoutBare title="Acceso privado">
  <div class="grid grid-cols-1 md:grid-cols-[1.1fr_1fr] min-h-screen">
    <aside class="hidden md:flex relative overflow-hidden flex-col border-r border-border bg-muted p-14">
      <div
        class="pointer-events-none absolute top-1/2 left-1/2 h-150 w-150 -translate-x-1/2 -translate-y-1/2 rounded-full"
        style="background: radial-gradient(circle, color-mix(in oklab, var(--primary) 16%, transparent) 0%, transparent 60%);"
      >
      </div>

      <div class="relative z-2 font-serif-display text-2xl flex items-baseline gap-3">
        Khelde<span class="text-primary">.</span>
      </div>

      <div class="relative z-2 flex-1 flex flex-col justify-center">
        <p class="font-serif-display text-4xl lg:text-5xl leading-[1.05] max-w-[16ch] mb-6">
          Acceso reservado al <span class="text-primary italic">administrador.</span>
        </p>
        <p class="khelde-lead text-muted-foreground max-w-[38ch]">
          Desde aquí se alimenta el portafolio: proyectos, experiencia,
          educación, habilidades, opiniones y mensajes se editan en vivo.
        </p>
      </div>
    </aside>

    <main class="flex items-center justify-center px-6 py-16">
      <form id="login-form" class="w-full max-w-sm flex flex-col gap-6">
        <a
          href="/"
          class="eyebrow inline-flex items-center gap-2 w-fit hover:text-primary transition-colors"
        >
          <span aria-hidden="true">←</span> Volver al portafolio
        </a>

        <div>
          <h1 class="font-serif-display text-5xl mb-3">
            Acceso<br />privado<span class="text-primary">.</span>
          </h1>
          <p class="text-sm text-muted-foreground">
            Inicia sesión para administrar el contenido del sitio.
          </p>
        </div>

        <p
          id="login-error"
          class="hidden items-center gap-2 rounded-md border border-destructive/30 bg-destructive/10 px-3.5 py-2.5 text-sm text-destructive"
        >
          Credenciales inválidas.
        </p>

        <div class="flex flex-col gap-4">
          <div class="space-y-1.5">
            <label for="email" class="eyebrow">Email</label>
            <input
              id="email"
              type="email"
              name="email"
              required
              autocomplete="username"
              class="h-11 w-full rounded-lg border border-input bg-transparent px-3 text-base outline-none transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50"
              placeholder="tu@correo.com"
            />
          </div>
          <div class="space-y-1.5">
            <label for="password" class="eyebrow">Contraseña</label>
            <div class="relative">
              <input
                id="password"
                type="password"
                name="password"
                required
                autocomplete="current-password"
                class="h-11 w-full rounded-lg border border-input bg-transparent px-3 pr-11 text-base outline-none transition-colors placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50"
                placeholder="••••••••"
              />
              <button
                type="button"
                id="toggle-password"
                aria-label="Mostrar contraseña"
                aria-pressed="false"
                class="absolute inset-y-0 right-0 flex items-center px-3 text-muted-foreground hover:text-foreground transition-colors"
              >
                <svg
                  id="icon-eye"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <svg
                  id="icon-eye-off"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="hidden"
                >
                  <path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path>
                  <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path>
                  <path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path>
                  <path d="m2 2 20 20"></path>
                </svg>
              </button>
            </div>
          </div>

          <button
            type="submit"
            class="mt-2 inline-flex items-center justify-center gap-2 h-11 w-full rounded-lg bg-primary text-primary-foreground font-medium transition-colors hover:bg-primary/80"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="1.8"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="currentColor" stroke-width="1.8"></path>
            </svg>
            Entrar al panel
          </button>
        </div>
      </form>
    </main>
  </div>

  <script>
    import { adminLoginSchema } from "@/schemas/adminLoginSchema";

    const form = document.getElementById("login-form") as HTMLFormElement;
    const err = document.getElementById("login-error") as HTMLParagraphElement;

    const passwordInput = document.getElementById("password") as HTMLInputElement;
    const toggleBtn = document.getElementById("toggle-password") as HTMLButtonElement;
    const iconEye = document.getElementById("icon-eye") as HTMLElement;
    const iconEyeOff = document.getElementById("icon-eye-off") as HTMLElement;

    toggleBtn?.addEventListener("click", () => {
      const isHidden = passwordInput.type === "password";
      passwordInput.type = isHidden ? "text" : "password";
      iconEye.classList.toggle("hidden", isHidden);
      iconEyeOff.classList.toggle("hidden", !isHidden);
      toggleBtn.setAttribute("aria-pressed", String(isHidden));
      toggleBtn.setAttribute(
        "aria-label",
        isHidden ? "Ocultar contraseña" : "Mostrar contraseña",
      );
    });

    const showError = (message: string) => {
      err.textContent = message;
      err.classList.remove("hidden");
      err.classList.add("flex");
      form.classList.add("shake");
      setTimeout(() => form.classList.remove("shake"), 400);
    };

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      err.classList.add("hidden");

      const fd = new FormData(form);
      const payload = { email: fd.get("email"), password: fd.get("password") };

      // Valida en el cliente antes de gastar una llamada de red - mismo
      // schema que valida del lado del servidor (schemas/adminLoginSchema.ts),
      // así los dos lados nunca pueden desalinearse.
      const parsed = adminLoginSchema.safeParse(payload);
      if (!parsed.success) {
        showError(parsed.error.issues[0]?.message ?? "Datos inválidos.");
        return;
      }

      const res = await fetch("/api/admin/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(parsed.data),
      });

      if (res.ok) {
        window.location.href = "/admin";
        return;
      }

      if (res.status === 429) {
        showError("Demasiados intentos. Espera unos minutos.");
        return;
      }

      const body = await res.json().catch(() => null);
      showError(
        res.status === 400
          ? (body?.message ?? "Datos inválidos.")
          : "Credenciales inválidas.",
      );
    });
  </script>
</AdminLayoutBare>

<style>
  @keyframes shake {
    0%,
    100% {
      transform: translateX(0);
    }
    20% {
      transform: translateX(-6px);
    }
    40% {
      transform: translateX(6px);
    }
    60% {
      transform: translateX(-3px);
    }
    80% {
      transform: translateX(3px);
    }
  }
  .shake {
    animation: shake 0.4s;
  }
</style>
