---
import { Nav } from "@/components/sections/Nav";
import Acerca from "@/components/sections/Acerca.astro";
import Contactos from "@/components/sections/Contacto.astro";
import Footer from "@/components/sections/Footer.astro";
import Header from "@/components/sections/Header.astro";
import MantraRibbon from "@/components/sections/MantraRibbon.astro";
import Opiniones from "@/components/sections/Opiniones.astro";
import Proyectos from "@/components/sections/Proyectos.astro";
import Layout from "@/layouts/Layout.astro";

const { currentLocale } = Astro;
---

<Layout>
  <Nav client:idle currentLocale={currentLocale} />
  <main role="main" class="pt-[72px]">
    <div class="mx-auto max-w-[1240px] px-6 scroll-mt-[88px]" id="home">
      <Header />
    </div>
    <MantraRibbon />
    <div id="about" class="scroll-mt-[88px]">
      <Acerca />
    </div>
    <div id="projects" class="scroll-mt-[88px]">
      <Proyectos />
    </div>
    <div id="opinions" class="scroll-mt-[88px]">
      <Opiniones />
    </div>
    <div id="contact" class="scroll-mt-[88px]">
      <Contactos />
    </div>
  </main>
  <Footer />
</Layout>
