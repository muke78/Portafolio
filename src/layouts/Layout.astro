---
import "@/styles/styles.css";
import "@/styles/app.css";
import "swiper/swiper-bundle.css";
import { BackgroundEffects } from "@/components/three/BackgroundEffects";
import { getI18N } from "@/i18n";

const { currentLocale, url, site } = Astro;
const i18n = getI18N({ currentLocale });

const currentYear = new Date().getFullYear();
const siteOrigin = site ?? new URL("https://khelde.vercel.app");
const canonicalUrl = new URL(url.pathname, siteOrigin).toString();
const ogImageUrl = new URL("/kdl.webp", siteOrigin).toString();

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: i18n.HEADER.HEADER_NAME,
	jobTitle: i18n.ABOUTME.ABOUT_TITLE_CARD,
	description: i18n.META.META_DESCRIPTION,
	url: siteOrigin.toString(),
	image: ogImageUrl,
	sameAs: [
		"https://github.com/muke78",
		"https://www.linkedin.com/in/erick-miguel-gonz%C3%A1lez-rivera-96265b248/",
	],
};
---

<!doctype html>
<html lang={currentLocale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{i18n.META.META_TITLE}</title>
    <meta name="description" content={i18n.META.META_DESCRIPTION} />
    <!-- Open Graph Meta Tags (para Facebook, LinkedIn, y otras redes) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={i18n.META.META_TITLE} />
    <meta property="og:description" content={i18n.META.META_DESCRIPTION} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={i18n.META.META_IMAGE_ALT} />
    <meta property="og:site_name" content={i18n.META.META_TITLE} />

    <!-- Twitter Meta Tags -->
    <meta property="twitter:card" content="summary_large_image">
     <meta property="twitter:image" content={ogImageUrl} />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={i18n.META.META_TITLE} />
    <meta property="twitter:description" content={i18n.META.META_DESCRIPTION} />
    <meta property="twitter:image:alt" content={i18n.META.META_IMAGE_ALT} />

    <!-- Metadatos adicionales -->
    <meta name="theme-color" content="#6f37cf" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="muke78" />
    <meta name="copyright" content={`Copyright © ${currentYear}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Structured data (SEO) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("theme");
        var dark = stored
          ? stored === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
  </head>
  <body class="bg-background text-foreground overflow-x-hidden">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-full focus:bg-primary focus:text-primary-foreground focus:px-5 focus:py-3 focus:text-sm focus:font-medium"
    >
      {i18n.COMMON.SKIP_TO_CONTENT}
    </a>
    <BackgroundEffects client:idle />
    <div class="relative z-[2]">
      <slot />
    </div>
    <script src="../js/ascii.js"></script>
    <script src="../js/scrollFix.js"></script>
  </body>
</html>
