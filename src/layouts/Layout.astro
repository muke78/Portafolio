---
import "@/styles/styles.css";
import "@/styles/app.css";
import { BackgroundEffects } from "@/components/three/BackgroundEffects";
import { getI18N } from "@/i18n";
import { DEFAULT_LOCALE } from "@/i18n/locales";
import {
	INTRO_GATE_SCRIPT,
	MOTION_GATE_SCRIPT,
	THEME_SCRIPT,
} from "@/lib/inlineScripts";
import { getContact } from "@/lib/siteContact";
import { getSiteCopy } from "@/lib/siteCopy";

interface Props {
	/** Page <title> / og:title. Defaults to the site title. */
	title?: string;
	/** Meta description. Defaults to the site description. */
	description?: string;
	/** Absolute URL of the social preview image. Defaults to /logo-og.png. */
	image?: string;
	/** Solo el Home tiene la puerta de la introduccion (el punto cero). */
	intro?: boolean;
}

const { url, site } = Astro;
const currentLocale = Astro.currentLocale ?? DEFAULT_LOCALE;
const { title, description, image, intro = false } = Astro.props;
const i18n = getI18N({ currentLocale });
const contact = await getContact();
const copy = await getSiteCopy(currentLocale);

const currentYear = new Date().getFullYear();
const siteOrigin = site ?? new URL(url.origin);
const canonicalUrl = new URL(url.pathname, siteOrigin).toString();
const ogImageUrl = image ?? new URL("/logo-og.png", siteOrigin).toString();
const pageTitle = title ?? i18n.META.META_TITLE;
const siteDescription = copy?.meta_description ?? i18n.META.META_DESCRIPTION;
const pageDescription = description ?? siteDescription;

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: i18n.HEADER.HEADER_NAME,
	jobTitle: i18n.ABOUTME.ABOUT_TITLE_CARD,
	description: siteDescription,
	url: siteOrigin.toString(),
	image: ogImageUrl,
	sameAs: [contact.github_url, contact.linkedin_url],
};
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <!-- Open Graph Meta Tags (para Facebook, LinkedIn, y otras redes) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageUrl} />
    {!image && (
      <>
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:image:alt" content={i18n.META.META_IMAGE_ALT} />
    <meta property="og:site_name" content={i18n.META.META_TITLE} />

    <!-- Twitter Meta Tags -->
    <meta property="twitter:card" content="summary_large_image">
     <meta property="twitter:image" content={ogImageUrl} />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={pageDescription} />
    <meta property="twitter:image:alt" content={i18n.META.META_IMAGE_ALT} />

    <!-- Metadatos adicionales -->
    <meta name="theme-color" content="#f8f7f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0d13" media="(prefers-color-scheme: dark)" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="muke78" />
    <meta name="copyright" content={`Copyright © ${currentYear}`} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Structured data (SEO) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema).replaceAll("<", "\\u003c")} />
    <!-- Corren antes del primer pintado; su hash esta en el CSP (src/lib/inlineScripts.ts). -->
    <script is:inline set:html={MOTION_GATE_SCRIPT}></script>
    <script is:inline set:html={THEME_SCRIPT}></script>
    {intro && <script is:inline set:html={INTRO_GATE_SCRIPT}></script>}
  </head>
  <body class="bg-background text-foreground overflow-x-hidden">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-full focus:bg-primary focus:text-primary-foreground focus:px-5 focus:py-3 focus:text-sm focus:font-medium"
    >
      {i18n.COMMON.SKIP_TO_CONTENT}
    </a>
    <div
      data-scroll-progress
      aria-hidden="true"
      class="pointer-events-none fixed inset-x-0 top-0 z-100 h-0.5 bg-primary"
    >
    </div>
    <BackgroundEffects client:idle />
    <div class="relative z-2">
      <slot />
    </div>
    <script>
      import { initMotion } from "@/lib/motion";

      initMotion();
    </script>
    <script src="../js/ascii.js"></script>
    <script src="../js/scrollFix.js"></script>
  </body>
</html>
