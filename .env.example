# Copy this file to .env and fill in real values.
# See astro.config.mjs `env.schema` for the source of truth.

# Public: base URL of the content API (projects/experiences/comments).
VITE_API_URL=

# Server-only, secret: bearer token the admin proxy (/api/admin/resource)
# sends to VITE_API_URL.
API_SECRET_TOKEN=

# Server-only, secret: password for /admin/login. Compared with a
# constant-time check (src/pages/api/admin/login.ts) - pick something
# long and random, not a memorable phrase.
ADMIN_PASSWORD=

# Server-only, secret: HMAC key signing the admin session cookie
# (src/lib/adminSession.ts). Any long random string; rotating it
# invalidates every existing admin session immediately.
ADMIN_SESSION_SECRET=
