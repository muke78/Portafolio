# Copy this file to .env and fill in real values.
# See astro.config.mjs `env.schema` for the source of truth.

# Public: base URL of the content API (projects/experiences/comments).
VITE_API_URL=

# Public (optional): origin of the R2 bucket that serves the images. Defaults to
# the r2.dev URL; with a custom domain use e.g. https://media.khelde.dev.
PUBLIC_MEDIA_URL=

# Build-time (optional): public URL of the site, used for canonical URLs, the
# sitemap and robots.txt. Read by astro.config.mjs, not by astro:env.
SITE_URL=

# Public (optional): Cloudflare Turnstile site key. Build variable. Without it the
# widget is not drawn (fine for `pnpm dev`).
PUBLIC_TURNSTILE_SITE_KEY=

# Server-only, secret: Turnstile secret key. Without it the public forms answer 503
# in production; in `pnpm dev` they are accepted without a token.
TURNSTILE_SECRET_KEY=

# Server-only, secret: bearer token the /api/* proxy sends to VITE_API_URL.
API_SECRET_TOKEN=
